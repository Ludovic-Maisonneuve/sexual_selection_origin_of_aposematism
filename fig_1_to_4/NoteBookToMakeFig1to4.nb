Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "definition", " ", "to", " ", "plot", " ", "temporal", 
    " ", "dynamics", " ", "based", " ", "on", " ", "parameters"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"TemporalDynamicsFig1", "[", "params_", "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "threshold", ",", "params1", ",", "traits2", ",", " ", "data1", ",", 
        "data2", ",", " ", "data", ",", "TableDyns", ",", "TableDynd", ",", 
        "dataTheta", ",", "dataPreyKilled", ",", "p1", ",", "p2", ",", "p3"}],
        "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Calculate", " ", "the", " ", "threshold", " ", "value", " ", 
        OverscriptBox["s", "~"]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"threshold", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"1", "/", "\[Beta]d"}], "*", 
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "*", 
              RowBox[{"(", "\[Beta]e", ")"}], "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", "Pd0"}], ")"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"p", "*", 
               RowBox[{"(", "\[Beta]e", ")"}]}], "-", "\[Gamma]cd1"}], 
             ")"}]}], "]"}]}], "/.", "params"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Compute", " ", "the", " ", "selection", " ", "gradient", " ", 
          "iterations", " ", "for", " ", "the", " ", "model", " ", "with", 
          " ", "sex"}], "-", 
         RowBox[{"independent", " ", "traits"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"SelGradIterateFor", "[", 
         RowBox[{
         "SModel1", ",", " ", "traitsModel1", ",", " ", "params", ",", 
          "1500"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Create", " ", "a", " ", "table", " ", "with", " ", "values", " ", 
          "of", " ", "traits"}], ",", " ", 
         RowBox[{
         "\[Theta]", " ", "and", " ", "the", " ", "probability", " ", "that", 
          " ", "a", "\n", "prey", " ", "gets", " ", "killed", " ", "by", " ", 
          "predators", " ", "at", " ", "each", " ", "time", " ", "step"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"TableDyns", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"t", ",", "1"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "1", ",", " ", 
            RowBox[{
             RowBox[{"Dimensions", "[", "data", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"TableDynd", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"t", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "1", ",", " ", 
            RowBox[{
             RowBox[{"Dimensions", "[", "data", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dataTheta", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Theta", "[", 
               RowBox[{"s", ",", "d"}], "]"}], "/.", 
              RowBox[{"MakeRule", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"s", ",", "d"}], "}"}], ",", 
                RowBox[{"data", "[", 
                 RowBox[{"[", "t", "]"}], "]"}]}], "]"}]}], "/.", 
             "params"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "1", ",", 
            RowBox[{
             RowBox[{"Dimensions", "[", "data", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dataPreyKilled", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"1", "-", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "p"}], " ", 
                 RowBox[{"Pd", "[", "s", "]"}], 
                 RowBox[{"Pa", "[", 
                  RowBox[{"s", ",", "s", ",", "d"}], "]"}], 
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"Pe", "[", "d", "]"}]}], ")"}]}], "]"}]}], "/.", 
              RowBox[{"MakeRule", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"s", ",", "d"}], "}"}], ",", 
                RowBox[{"data", "[", 
                 RowBox[{"[", "t", "]"}], "]"}]}], "]"}]}], "/.", 
             "params"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "1", ",", 
            RowBox[{
             RowBox[{"Dimensions", "[", "data", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Plots", " ", "the", " ", "dynamics", " ", "of", " ", "traits"}], 
         ",", " ", 
         RowBox[{
         "\[Theta]", " ", "and", " ", "the", " ", "probability", " ", "that", 
          " ", "a", "\n", "prey", " ", "gets", " ", "killed", " ", "by", " ", 
          "predators"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"p1", "=", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"TableDyns", ",", "TableDynd"}], "}"}], ",", 
          RowBox[{"PlotStyle", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"Thick", ",", "purple"}], "]"}], ",", 
             RowBox[{"Directive", "[", 
              RowBox[{"Thick", ",", "green"}], "]"}]}], "}"}]}], ",", 
          RowBox[{"PlotRange", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"All", ",", "All"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"All", ",", " ", "All"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"Frame", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"True", ",", " ", "False"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"True", ",", " ", "False"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"LabelStyle", "\[Rule]", "style"}], ",", 
          RowBox[{"AxesOrigin", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}]}], ",", 
          RowBox[{"Epilog", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"Dashing", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"1", "/", "100"}], ",", 
                  RowBox[{"1", "/", "100"}]}], "}"}], "]"}], ",", "Black"}], 
              "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "100"}], ",", "threshold"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
